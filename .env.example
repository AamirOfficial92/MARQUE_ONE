# Supabase Public Configuration (safe for browser with Row Level Security enabled)
# Supported URL variables: VITE_SUPABASE_URL or NEXT_PUBLIC_SUPABASE_URL
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Supported Key variables:
# VITE_SUPABASE_ANON_KEY, VITE_SUPABASE_PUBLISHABLE_KEY,
# NEXT_PUBLIC_SUPABASE_ANON_KEY, or NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Optional: Resend Email API (server-side only, used by /api/send-email; app works fully without these)
# RESEND_API_KEY=""
# RESEND_FROM_EMAIL="Marquee 1 <onboarding@resend.dev>"
